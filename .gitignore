# Virtual environment
venv/
.venv/

# Python cache
__pycache__/
*.pyc

# Captured photos (regenerated each run)
photo_*.jpg

# Local backup logs — these are per-machine transactional data, not code
logs/*.jsonl
PnP_App/detections/*
!PnP_App/detections/.gitkeep

# Raw / auto-generated datasets (large, regenerable via auto_annotate.py)
Preannotate/auto_images/*
Preannotate/auto_labels/*
Preannotate/auto_preview/*
Preannotate/dataset/*
Preannotate/runs/*
Preannotate/Fotos_figuritas.zip
Preannotate/yolo11n.pt

# Mantener las carpetas en el repo (vacías)
!Preannotate/auto_images/.gitkeep
!Preannotate/auto_labels/.gitkeep
!Preannotate/auto_preview/.gitkeep
!Preannotate/dataset/.gitkeep
!Preannotate/runs/.gitkeep

# Solo subir entrenar.py de Preannotate (ignorar los demás .py)
Preannotate/*.py
!Preannotate/entrenar.py

# Redundant/large files not part of this repo
PnP_App.zip
2203.10939.pdf
ImageClasifYolo/
Training_Yael/

# Jupyter checkpoints
.ipynb_checkpoints/

# Environment secrets (Convex URL/keys, SMTP, etc.)
.env

